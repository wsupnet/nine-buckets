.venv/
.venv.*/
__pycache__/
*.pyc

# Your data and secrets — never commit these.
.env
.env.*
!.env.example
# ./data is the default data folder. It is kept in the repo (empty, via
# .gitkeep) so a clone creates it owned by you rather than Docker creating it
# as root; everything inside it stays untracked.
/data/*
!/data/.gitkeep
dev-data/
backups/
*.db
*.db-*
*.sqlite*
*-wal
*-shm
*-journal
*.tmp
*.part
.session_secret
.app_password
.write-probe
*.log
*.csv
*.xlsx
*.xlsm

# Personal notes and local tooling.
*.local.md
*.local.env
.claude/
.DS_Store
