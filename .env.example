# OPTIONAL. The app starts without a .env. Copy this file to .env (same folder)
# only to change the settings below. .env is gitignored — never commit it.
# Start the app with:  docker compose up -d --build
#
# docker-compose.yml reads only APP_PASSWORD, NETWORTH_DATA, SECRET_KEY and TZ
# from this file; every other setting is inline in docker-compose.yml. Outside Docker the
# app does not load .env itself; set the variables in your shell first.

# Sign-in passphrase, min. 8 characters. Leave empty and one is generated on
# first start, printed once in the log and kept in the data folder as
# .app_password. To use your own, put something long here, e.g. four or five
# random words.
APP_PASSWORD=

# The ONE folder that holds all your data: the database, the session secret and
# the backups/ folder. Default: ./data next to docker-compose.yml.
# On a NAS, use a folder OUTSIDE the project folder, for example:
#   NETWORTH_DATA=/volume1/docker/appdata/networth/data
# NETWORTH_DATA=./data

# Session-signing key. Leave empty and a random key is generated and stored in
# the data folder as .session_secret, which keeps you signed in across restarts.
SECRET_KEY=

# Container timezone (IANA name). Sets log times. UTC if unset.
TZ=UTC

# ---- Read by the app, but set inline in docker-compose.yml -----------------
# Under Docker these lines have no effect: change them in docker-compose.yml.
# They are listed so running outside Docker has the full set. Every value shown
# is the default (outside Docker the database is ./data/networth.db and backups
# go in ./data/backups, the same folder compose uses).
# DB_PATH=./data/networth.db
# BACKUP_DIR=./data/backups
# AUTH_ENABLED=1
# SESSION_DAYS=30
# SESSION_HTTPS_ONLY=0
# SEED_DEMO=0
# REFRESH_ENABLED=1
# REFRESH_ON_START=1
# REFRESH_INTERVAL_HOURS=24
# BACKUP_ENABLED=1
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=30
# LOG_LEVEL=INFO
