# Copy to .env and edit. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# docker-compose.yml reads only the values in the first two sections from this
# file; every other setting is inline in docker-compose.yml. Outside Docker the
# app does not load .env itself — export it first:  set -a; . ./.env; set +a

# ---- Required -------------------------------------------------------------
# Sign-in passphrase. Min 8 characters; the app rejects this placeholder.
# Generate a strong value with:  openssl rand -base64 24
APP_PASSWORD=change-me-to-a-long-passphrase

# Parent folder for app data, kept OUTSIDE the repo. Compose mounts
# $APPDATA/networth/data at /data and $APPDATA/networth/backups at /backups.
# On the NAS set this to:  APPDATA=/volume1/docker/appdata
# ./dev-data (git-ignored) is for running it locally.
APPDATA=./dev-data

# ---- Optional -------------------------------------------------------------
# Session-signing key. Leave empty and a random key is generated and stored at
# $DB_PATH's folder/.session_secret, which keeps you signed in across restarts.
SECRET_KEY=

# Container timezone (IANA name). Sets log times. UTC if unset.
TZ=UTC

# ---- Read by the app, but set inline in docker-compose.yml -----------------
# Under Docker these lines have no effect: change them in docker-compose.yml.
# They are listed so running outside Docker (after the export above) has the
# full set. The two paths are suggestions that match the dev-data layout (the
# built-in defaults are ./data/networth.db and a backups/ folder beside it);
# every other value shown is the default.
# DB_PATH=./dev-data/networth/data/networth.db
# BACKUP_DIR=./dev-data/networth/backups
# AUTH_ENABLED=1
# SESSION_DAYS=30
# SESSION_HTTPS_ONLY=0
# SEED_DEMO=0
# REFRESH_ENABLED=1
# REFRESH_ON_START=1
# REFRESH_INTERVAL_HOURS=24
# BACKUP_ENABLED=1
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=30
# LOG_LEVEL=INFO
