# Copy to .env and edit. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# docker-compose.yml reads only the values below from this file; every other
# setting is inline in docker-compose.yml. Outside Docker the app does not load
# .env itself — export it first:  set -a; . ./.env; set +a

# ---- Required -------------------------------------------------------------
# Sign-in passphrase. Min 8 characters; the app rejects this placeholder.
# Generate a strong value with:  openssl rand -base64 24
APP_PASSWORD=change-me-to-a-long-passphrase

# ---- Optional -------------------------------------------------------------
# Session-signing key. Leave empty and a random key is generated and stored at
# $DB_PATH's folder/.session_secret, which keeps you signed in across restarts.
SECRET_KEY=

# Container timezone (IANA name). Sets backup filenames and log times. UTC if unset.
TZ=UTC

# ---- Local development only (Docker sets these in docker-compose.yml) ------
# Where the SQLite database lives. Keep it outside the project folder.
# DB_PATH=/path/to/networth-data/networth.db
# Insert the sample portfolio into an empty database. Keep 0 for real use.
# SEED_DEMO=0
